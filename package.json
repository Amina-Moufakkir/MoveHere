{
  "name": "movehere",
  "version": "0.0.0",
  "private": true,
  "description": "Environment-aware workout generation, park-first. Confirmed venue features drive deterministic session generation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve out",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:runtime": "node --experimental-strip-types --test tests/runtime/*.test.ts",
    "check:feasibility": "node scripts/check-feasibility.mjs",
    "verify": "npm run typecheck:domain && npm run typecheck && npm run test:contracts && npm run test:runtime && npm run check:feasibility && npm run check:palette",
    "check:palette": "node scripts/check-palette.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
